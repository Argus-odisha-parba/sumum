<IfModule mod_rewrite.c>
    RewriteEngine On

    # Old URL: doctor-profile.php?id=dr-name → /doctors/dr-name
    RewriteCond %{THE_REQUEST} \s[^\s]*doctor-profile\.php\?id=([a-zA-Z0-9\-]+) [NC]
    RewriteRule ^doctor-profile\.php$ doctors/%1? [R=301,L]

    # SEO-friendly doctor profiles
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^doctors/([a-zA-Z0-9\-]+)/?$ doctor-profile.php?slug=$1 [L,QSA]
</IfModule>
